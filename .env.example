# Copy this file to .env and fill in only the channels you want.
# .env is git-ignored. Never commit real credentials.

# Discord alerts: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Email alerts (Gmail): turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use that 16-character code below.
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465), ALERT_EMAIL_FROM

# Optional: the whole config as YAML text. Hosted setups use this to keep the
# site list out of the public repository.
# SENTINEL_CONFIG=
